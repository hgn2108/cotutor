# Backend (copy to .env at the repo root)
GEMINI_API_KEY=                        # free key: https://aistudio.google.com/apikey
# Fallback chains, first choice first: used in order when a model is overloaded (503/429)
COTUTOR_SMART_MODELS=gemini-3.8-flash,gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash,gemini-3.5-flash-lite   # solver, test designer, debugger, coach
COTUTOR_FAST_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite            # analyst, tutor
COTUTOR_ALLOWED_ORIGINS=http://localhost:5173
COTUTOR_RUNS_PER_HOUR=20                # per-IP limit on the shared key

# Frontend (web/.env.local) — only needed when the API is on another origin
# VITE_API_URL=https://your-space.hf.space
